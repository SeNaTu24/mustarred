{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mustarred.com" }],
      "destination": "https://www.mustarred.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wp-proxy/:path*",
      "destination": "https://cms.mustarred.com/wp-json/wp/v2/:path*"
    },
    {
      "source": "/((?!assets/|sitemap.xml|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
